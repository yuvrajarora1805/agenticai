# WareSync AI Environment Variables Configuration
# Copy this file to .env or edit .env directly

# Server Port Mapping
# Default is 8000, or set to 3010 / 8080 if 8000 or 3000-3005 are occupied by other containers
PORT=8000

# Google Gemini / LLM Configuration
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Environment
ENVIRONMENT=production
PYTHONUNBUFFERED=1
